APP_NAME="Conveyor Uni Express"
APP_ENV=local
APP_KEY=base64:I/4j1tloW8+tsCvytB3W4DwGSLQh6g19Trho8C9qaD4=
APP_DEBUG=true
APP_URL=https://dev2.australianmartltd.com/

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=austral5_dev2
DB_USERNAME=austral5_dev2
DB_PASSWORD=austral5_dev2

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CKE Express API Credentials
CKE_ENABLED=true
CKE_BASE_URL=http://www.ckeex.com/cgi-bin/EmsData.dll
CKE_TRACK_URL=http://www.ckeex.com/cgi-bin/GInfo.dll

# Carrier category sent as cEmsKind for every parcel (see EmsKindList). Required by CKE.
CKE_DEFAULT_EMS_KIND=UPS

# Requests are signed with MD5(icID + TimeStamp + key) only when BOTH are set; otherwise sent unsigned.
CKE_ICID=9886
CKE_API_KEY=ER3T56TNJUYKSDW

# Optional extra request headers, if CKE verifies requests that way instead of a signature.
CKE_HEADER_AUTHENTICATE=
CKE_HEADER_VERSION=
CKE_TIMEOUT=30
CKE_TRACK_TIMEOUT=120
CKE_TRACK_BATCH=20
