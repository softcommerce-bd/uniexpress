<IfModule php8_module>
   php_value error_log "/home/ogctbdco/logs/php.error.log"
   php_flag log_errors On
</IfModule>

<IfModule lsapi_module>
   php_value error_log "/home/ogctbdco/logs/php.error.log"
   php_flag log_errors On
</IfModule>

# END cPanel-generated php ini directives, do not edit


# Laravel public folder routing
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect direct /public URLs to clean URL
    RewriteCond %{THE_REQUEST} \s/+public(?:/([^\s?]*))? [NC]
    RewriteRule ^public/?(.*)$ /$1 [R=301,L]

    # Do not rewrite requests already internally sent to /public
    RewriteCond %{REQUEST_URI} !^/public/

    # Route everything internally to Laravel public folder
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
